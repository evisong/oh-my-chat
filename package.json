    "#components/*": "./src/components/*",
    "#context/*": "./src/context/*",
    "#hooks/*": "./src/hooks/*",
    "#stores/*": "./src/stores/*",
    "#types/*": "./src/types/*"
  },
  "dependencies": {
    "@langchain/core": "^0.2.20",
    "@langchain/ollama": "^0.0.2",
    "@linaria/core": "^6.1.0",
    "@linaria/react": "^6.1.0",
    "@tanstack/react-query": "^5.50.1",
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "react-router-dom": "^6.23.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.9",
    "@babel/preset-env": "^7.24.8",
    "@babel/preset-react": "^7.24.7",
